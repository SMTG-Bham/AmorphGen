# ======================
# Atomistic simulation files
# ======================
*.xyz
*.extxyz
*.traj
*.dump
*.lammps
*.lammpstrj
*.h5
*.hdf5
*.nc
*.cif
*.POSCAR
POSCAR
# Track curated example / validation structures even though *.xyz is ignored.
!examples/**/*.xyz
!examples/**/*.extxyz
!examples/**/*.cif
# Offline experimental test fixtures must be present in clean checkouts.
!test/data/experimental/*.xyz
CONTCAR
OUTCAR
XDATCAR
OSZICAR
vasprun.xml
# ======================
# MACE / ML potential files
# ======================
*.model
*.pt
*.pth
*.ckpt
*.pkl
*.sav

# ======================
# HPC / job scheduler outputs
# ======================
*.out
*.err
slurm-*.out
job_*.sh.o*
job_*.sh.e*
core.*

# ======================
# Python
# ======================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/

# ======================
# Jupyter Notebooks
# ======================
.ipynb_checkpoints/
# JupyterLab Desktop per-user window layout, not part of the tutorials
.jupyter/
*.jupyterlab-workspace
*.ipynb_checkpoints

# ======================
# Virtual environments
# ======================
.env
.venv
env/
venv/
# pip requirements file conda writes next to the environment file while
# `conda env create -f build_tools/...` runs (left behind if it is killed)
build_tools/condaenv.*.requirements.txt

# ======================
# macOS
# ======================
.DS_Store
.AppleDouble
.LSOverride

# ======================
# Editors
# ======================
.vscode/
.idea/
*.swp
*.swo
*~

# ======================
# Sphinx docs build output
# ======================
docs/_build/

# ======================
# Large output/results directories
# ======================
results/
outputs/
scratch/
tmp/
logs/

# ======================
# Internal experiments / archived research code
# Kept locally for revival, not published to either remote.
# ======================
experiments/

# ======================
# Test / scratch outputs
# ======================
gen_*/
factor_test*/
random_*/
.coverage
*.png
!docs/**/*.png
test_mace_overnight.py

# ======================
# Local diagnostic / one-off scripts
# (kept on disk for revival, not shipped)
# ======================
diag_*.py
sync_*.sh

# ======================
# Local code-review / session reports
# (timestamped Markdown audits that don't belong upstream)
# ======================
review_report/
CODE_REVIEW_*.md
AUDIT_*.md
STRENGTHS_AUDIT_*.md
NEW_USER_REVIEW_*.md
CARRY_FORWARD.md

# ======================
# Tutorial run outputs
# (underscore-prefixed dirs are large auto-generated outputs)
# ======================
Tutorials/_*/

# ======================
# LaTeX scratch
# ======================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
texput.log

# local agent/editor instructions, not part of the distribution
CLAUDE.md

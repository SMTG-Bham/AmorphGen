# Files the sdist needs beyond what setuptools finds itself. By default it takes
# only test/test*.py from the suite, which leaves out conftest.py (the fixtures
# and the --run-mace gate), so the tests of an unpacked sdist would fail.
recursive-include test *.py
include Tutorials/analysis_helpers.py
recursive-include Tutorials *.ipynb
# Offline experimental benchmarks must also run from an unpacked sdist.
recursive-include test/data *.xyz *.md
recursive-include test/data/feff *.dat *.json LICENSE.*
recursive-include examples/exafs *.py *.md
# The Slurm regression tests exercise these workflow/script examples.
include examples/slurm_workflow.yaml
include examples/*.slurm
include examples/softwarex_bks_sio2.yaml
# Tutorial 8 and the --reference examples read the shipped reference files.
include examples/reference_a_*.yaml
recursive-include Tutorials/T8_validation_workflow/structures *.xyz
# An executed copy of Tutorial 8 left by nbconvert must not reach the sdist.
exclude Tutorials/T8_validation_workflow/executed.ipynb
